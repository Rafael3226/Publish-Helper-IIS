{
  "routes": [
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/403.html" },
    { "route": "/*", "allowedRoles": ["deployer"] }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/403.html"
    }
  },
  "globalHeaders": {
    "Cache-Control": "no-cache"
  }
}
