<?xml version="1.0" encoding="utf-8"?>
<!-- IIS only: IIS 8.5 and older do not serve .json, which the presets are loaded from.
     Removing first keeps IIS 10, which already knows .json, from failing on a duplicate. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
