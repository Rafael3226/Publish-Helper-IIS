  "mssqlEnabled": false,
  "mssqlTool": "sqlcmd",
  "mssqlServer": "",
  "mssqlDatabase": "",
  "mssqlAuth": "windows",
  "mssqlUser": "",
  "mssqlPassword": "",
  "mssqlTrustCert": false,
  "mssqlDir": "",
  "mssqlFiles": "",
  "as400Enabled": false,
  "as400Tool": "odbc",
  "as400System": "",
  "as400Database": "",
  "as400Library": "",
  "as400User": "",
  "as400Password": "",
  "as400Driver": "IBM i Access ODBC Driver",
  "as400Dir": "",
  "as400Files": "",
  "projects": [
    {
      "enabled": true,
      "name": "ACTPOLGatewayAPI",
      "sourceMode": "zip",
      "sourceSub": "ACTS_API",
      "sourceAbs": "",
      "targets": [
        "C:\\Team .NET\\Web services\\ACTPOLGatewayAPI"
      ],
      "pool": "ACTPOLGatewayAPI",
      "site": "",
      "backup": true,
      "keepText": "appsettings.json\nappsettings.Development.json\nweb.config"
    }
  ]
